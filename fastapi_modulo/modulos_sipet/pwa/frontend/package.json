    "build:all": "npm run build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "daisyui": "^4.12.10",
    "grapesjs": "^0.21.13"
  }
}
