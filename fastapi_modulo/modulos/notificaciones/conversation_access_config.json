{
  "title": "Conversaciones",
  "help_badge": "?",
  "role_label": "Nivel de acceso",
  "roles": [
    { "value": "", "label": "Sin acceso" },
    { "value": "usuario", "label": "Usuario" },
    { "value": "moderador", "label": "Moderador" },
    { "value": "supervisor", "label": "Supervisor" },
    { "value": "administrador", "label": "Administrador" }
  ],
  "toggles": [
    {
      "key": "can_create_groups",
      "label": "Puede crear grupos",
      "data_attr": "create-groups",
      "enabled_when_role": ["usuario", "moderador", "administrador"]
    },
    {
      "key": "can_send_notifications",
      "label": "Puede enviar notificaciones",
      "data_attr": "send-notifications",
      "enabled_when_role": ["supervisor", "administrador"]
    },
    {
      "key": "can_view_history",
      "label": "Puede ver historial",
      "data_attr": "view-history",
      "enabled_when_role": ["usuario", "moderador", "supervisor", "administrador"]
    },
    {
      "key": "can_delete_own_messages",
      "label": "Puede eliminar mensajes propios",
      "data_attr": "delete-own-messages",
      "enabled_when_role": ["usuario", "moderador", "administrador"]
    },
    {
      "key": "can_manage_group_members",
      "label": "Puede administrar miembros de grupos",
      "data_attr": "manage-group-members",
      "enabled_when_role": ["moderador", "supervisor", "administrador"]
    },
    {
      "key": "can_configure_notifications",
      "label": "Puede configurar notificaciones",
      "data_attr": "configure-notifications",
      "enabled_when_role": ["usuario", "moderador", "supervisor", "administrador"]
    },
    {
      "key": "can_moderate_groups",
      "label": "Puede moderar grupos",
      "data_attr": "moderate-groups",
      "enabled_when_role": ["moderador", "supervisor", "administrador"]
    },
    {
      "key": "can_access_reports",
      "label": "Puede acceder a reportes",
      "data_attr": "access-reports",
      "enabled_when_role": ["supervisor", "administrador"]
    }
  ],
  "scope_label": "Alcance de notificaciones",
  "scopes": [
    { "value": "", "label": "Solo conversación" },
    { "value": "department", "label": "Mi departamento" },
    { "value": "company", "label": "Toda la empresa" }
  ]
